## ⚙️ FASE 4: Gestor Dinámico de Clientes Telegram en `server.mjs`

Archivo: [server.mjs](file:///c:/Users/USUARIO/Desktop/proyectos/taximast/web/server.mjs)

### 4.1 Imports necesarios (agregar al inicio)

```javascript
import { TelegramClient } from "telegram";
import { StringSession } from "telegram/sessions/index.js";
import { NewMessage } from "telegram/events/index.js";
import mongoose from "mongoose";
```

### 4.2 Conexión a MongoDB y carga de modelos

> [!WARNING]
> `server.mjs` es un archivo ESM puro (no TypeScript). No puede importar directamente los modelos `.ts`. Hay dos opciones:
> 1. **Usar mongoose directamente** con `mongoose.model()` ya registrado por Next.js.
> 2. **Crear un helper `.mjs`** que conecte a MongoDB e importe los schemas.
> 
> **Opción recomendada:** Conectar mongoose directamente en `server.mjs` y usar `mongoose.model('Lineas')` después de que Next.js prepare la app (los modelos ya estarán registrados).

### 4.3 Gestor dinámico multi-línea

Agregar **dentro** de `app.prepare().then(...)`, después de configurar Socket.io:

```javascript
// ── TELEGRAM: Almacén de clientes activos ─────────────────────────
global.telegramClients = new Map();

async function initTelegramClients() {
    try {
        // Conectar a MongoDB (reutiliza la conexión de Next.js si ya existe)
        const MONGODB_URI = process.env.MONGODB_URI;
        if (!MONGODB_URI) {
            console.warn("[telegram] MONGODB_URI no definido, omitiendo Telegram.");
            return;
        }

        if (mongoose.connection.readyState !== 1) {
            await mongoose.connect(MONGODB_URI, { bufferCommands: false });
        }

        // Buscar líneas activas con credenciales de Telegram
        const Lineas = mongoose.model("Lineas");
        const lineas = await Lineas.find({
            activa: true,
            telegram_session: { $exists: true, $ne: "" },
            telegram_api_id: { $exists: true, $ne: null },
        }).select("+telegram_api_id +telegram_api_hash +telegram_session +gemini_api_key +gemini_prompt");

        for (const linea of lineas) {
            try {
                const session = new StringSession(linea.telegram_session);
                const client = new TelegramClient(
                    session,
                    parseInt(linea.telegram_api_id),
                    linea.telegram_api_hash,
                    { connectionRetries: 5 }
                );

                await client.connect();
                console.log(`✅ [Telegram] Conectado para línea: ${linea.name}`);

                global.telegramClients.set(linea._id.toString(), client);

                // Configurar escucha de mensajes entrantes (Fase 6)
                setupTelegramInbound(client, linea, io);
            } catch (err) {
                console.error(`❌ [Telegram] Error conectando línea ${linea.name}:`, err.message);
            }
        }

        if (lineas.length === 0) {
            console.log("[Telegram] No hay líneas con credenciales de Telegram configuradas.");
        }
    } catch (error) {
        console.error("❌ [Telegram] Error inicializando clientes:", error);
    }
}

// Iniciar después de un breve delay para que Next.js registre los modelos Mongoose
setTimeout(() => initTelegramClients(), 3000);
```

